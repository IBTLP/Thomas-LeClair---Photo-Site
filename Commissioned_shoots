<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Commissioned Shoots — Thomas LeClair Photography</title>
  <meta name="description" content="Commissioned automotive shoots by Thomas LeClair—understated luxury, editorial direction, and curated delivery. Local Commission, Signature Commission, and Editorial Feature Commission." />
  <link rel="canonical" href="https://www.tleclair.com/commissioned-shoots.html" />

  <!-- Open Graph -->
  <meta property="og:title" content="Commissioned Shoots — Thomas LeClair Photography" />
  <meta property="og:description" content="A tailored, editorial-style experience designed to create finished images—clean, intentional, and built to hold up in print or on screen." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.tleclair.com/commissioned-shoots.html" />
  <!-- Swap this image to one you want as the share preview -->
  <meta property="og:image" content="https://www.tleclair.com/images/home-landscape.webp" />

  <style>
    :root{
      --bg:#0e0e0e;
      --panel:#141414;
      --panel2:#101010;
      --text:#f5f5f5;
      --muted:rgba(245,245,245,.72);
      --muted2:rgba(245,245,245,.58);
      --line:rgba(255,255,255,.12);
      --soft:rgba(255,255,255,.06);
      --max:980px;
      --radius:18px;
    }

    *{ box-sizing:border-box; }

    html, body{ height:100%; }

    body{
      margin:0;
      font-family: system-ui,-apple-system,BlinkMacSystemFont,sans-serif;
      background:var(--bg);
      color:var(--text);
      line-height:1.55;
    }

    a{ color:var(--text); text-decoration:none; }
    a:hover{ opacity:.92; }

    /* ---------------- NAV (Auto-hide on scroll up) ---------------- */
    nav{
      position:fixed;
      top:-96px; /* hidden by default */
      left:0;
      width:100%;
      padding:1.5rem 2rem;
      display:flex;
      justify-content:space-between;
      align-items:center;
      background:rgba(14,14,14,0.85);
      backdrop-filter: blur(6px);
      border-bottom:1px solid rgba(255,255,255,.08);
      transition: top 0.28s ease;
      z-index:1000;
    }

    nav.show{ top:0; }

    nav .logo{
      font-weight:650;
      letter-spacing:.2px;
      color:var(--text);
      white-space:nowrap;
    }

    nav ul{
      list-style:none;
      display:flex;
      gap:1.5rem;
      margin:0;
      padding:0;
      align-items:center;
    }

    nav a{
      color:rgba(245,245,245,.78);
      font-size:0.95rem;
      letter-spacing:.2px;
      position:relative;
    }

    nav a:hover{ color:var(--text); }

    nav a::after{
      content:"";
      position:absolute;
      left:0;
      bottom:-6px;
      width:0%;
      height:1px;
      background:rgba(255,255,255,.38);
      transition: width .25s ease;
    }
    nav a:hover::after{ width:100%; }

    /* Highlight nothing here — this page is a “hidden gem” */
    /* You can add .active to About link later if you want */

    /* ---------------- PAGE WRAP ---------------- */
    main{
      max-width:var(--max);
      margin:0 auto;
      padding:7.25rem 1.25rem 3.25rem; /* room for hidden nav */
    }

    /* ---------------- HERO (Arrived) ---------------- */
    .hero{
      border:1px solid rgba(255,255,255,.10);
      border-radius:var(--radius);
      overflow:hidden;
      margin-bottom:1.6rem;
      background:
        linear-gradient(180deg, rgba(0,0,0,.34), rgba(14,14,14,.92)),
        /* Replace with a hero image you love */
        url("/images/home-landscape.webp");
      background-size:cover;
      background-position:center;
    }

    .hero-inner{
      padding:2.35rem 1.65rem;
    }

    .kicker{
      margin:0 0 .65rem;
      color:rgba(245,245,245,.70);
      letter-spacing:.16em;
      text-transform:uppercase;
      font-size:.78rem;
    }

    h1{
      margin:0 0 .65rem;
      font-size:2.55rem;
      letter-spacing:-.02em;
      line-height:1.12;
    }

    .hero-sub{
      margin:0;
      color:var(--muted);
      max-width:72ch;
      font-size:1.08rem;
    }

    .hero-meta{
      margin-top:1.1rem;
      display:flex;
      flex-wrap:wrap;
      gap:.55rem;
    }

    .pill{
      border:1px solid var(--line);
      border-radius:999px;
      padding:.42rem .72rem;
      font-size:.9rem;
      color:rgba(245,245,245,.78);
      background:rgba(255,255,255,.03);
    }

    .hero-actions{
      margin-top:1.25rem;
      display:flex;
      gap:.7rem;
      flex-wrap:wrap;
      align-items:center;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:.72rem 1.05rem;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.18);
      background:rgba(255,255,255,.06);
      color:var(--text);
      font-weight:650;
      letter-spacing:.2px;
      min-width: 190px;
      text-align:center;
      transition: border-color .2s ease, background .2s ease, transform .2s ease;
    }
    .btn:hover{
      border-color:rgba(255,255,255,.30);
      background:rgba(255,255,255,.08);
      transform: translateY(-1px);
    }

    .btn.secondary{
      background:transparent;
      border-color:rgba(255,255,255,.12);
      min-width: 150px;
    }

    /* ---------------- SECTIONS / PANELS ---------------- */
    .panel{
      background:linear-gradient(180deg, var(--panel), var(--panel2));
      border:1px solid rgba(255,255,255,.08);
      border-radius:var(--radius);
      padding:1.25rem 1.25rem;
    }

    h2{
      margin:0 0 .65rem;
      font-size:1.4rem;
      letter-spacing:-.01em;
    }

    h3{
      margin:0 0 .35rem;
      font-size:1.15rem;
      letter-spacing:-.01em;
    }

    .muted{ color:var(--muted); }
    .muted2{ color:var(--muted2); }

    ul{
      margin:.55rem 0 0 1.15rem;
      color:var(--muted);
    }
    li{ margin:.35rem 0; }

    .rule{
      height:1px;
      background:rgba(255,255,255,.06);
      margin:1.25rem 0;
    }

    /* ---------------- CARDS ---------------- */
    .grid{
      display:grid;
      grid-template-columns: 1fr;
      gap:1rem;
    }

    .card{
      border:1px solid rgba(255,255,255,.08);
      border-radius:var(--radius);
      padding:1.15rem 1.15rem;
      background:rgba(255,255,255,.03);
    }

    .tagline{
      margin:.2rem 0 0;
      color:var(--muted2);
      max-width: 78ch;
    }

    .price{
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      margin:.45rem 0 0;
      font-weight:700;
      color:var(--text);
    }

    .price span{
      font-weight:500;
      color:var(--muted2);
      font-size:.95rem;
    }

    .bestfor{
      margin:.8rem 0 0;
      color:var(--muted2);
      font-size:.98rem;
    }

    /* ---------------- REQUEST CTA ---------------- */
    .cta{
      display:flex;
      flex-wrap:wrap;
      gap:.75rem;
      align-items:center;
      justify-content:space-between;
      border-radius:var(--radius);
      border:1px solid rgba(255,255,255,.14);
      background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
      padding:1.1rem 1.1rem;
    }

    .cta strong{ font-size:1.05rem; }
    .cta p{ margin:.35rem 0 0; color:var(--muted); max-width:70ch; }

    /* ---------------- FOOTER ---------------- */
    footer{
      max-width:var(--max);
      margin:0 auto;
      padding:1.25rem 1.25rem 2.5rem;
      color:var(--muted2);
      border-top:1px solid rgba(255,255,255,.06);
    }

    footer .footlinks{
      display:flex;
      flex-wrap:wrap;
      gap:1rem;
      margin-top:.6rem;
    }

    footer a{ color:var(--muted2); }
    footer a:hover{ color:var(--text); }

    /* ---------------- RESPONSIVE ---------------- */
    @media (min-width: 860px){
      .grid{ grid-template-columns: 1fr 1fr; }
      .grid .card:last-child{ grid-column: 1 / -1; }
    }

    @media (max-width: 760px){
      nav{ padding:1.25rem 1.25rem; }
      nav ul{ gap:1rem; }
    }

    @media (max-width: 640px){
      nav ul{ display:none; } /* clean mobile */
      .btn{ width:100%; }
      .btn.secondary{ width:100%; }
      .hero-inner{ padding:2rem 1.25rem; }
      main{ padding:6.5rem 1.1rem 3rem; }
    }
  </style>

